# ─── App ───────────────────────────────────────────────
DEBUG=false
SECRET_KEY=super-secret-key-change-this

# ─── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# ─── Model ─────────────────────────────────────────────
MODEL_NAME=briaai/RMBG-2.0
MODEL_DEVICE=cuda   # Use "cpu" if no GPU

# ─── Cloudflare R2 ─────────────────────────────────────
# Get these from: dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=clearbg-images
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── PostgreSQL ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clearbg:password@localhost:5432/clearbg

# ─── Stripe ────────────────────────────────────────────
# Get from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ─── Clerk Auth ────────────────────────────────────────
# Get from: dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
